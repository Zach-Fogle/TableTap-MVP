# Create .env.local from this file and paste your Discord channel webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Optional. Defaults to America/New_York.
RESTAURANT_TIME_ZONE=America/New_York

# Enabled by default unless set to false. Stores requests in the
# Toast-style demo dashboard at /pos.
MOCK_POS_ENABLED=true

# Optional. Defaults to .data/tabletap.db and persists across local restarts.
TABLETAP_DB_PATH=.data/tabletap.db

# Required for staff queue access. Use a long random secret in real environments.
TABLETAP_AUTH_SECRET=replace-with-at-least-32-random-characters
TABLETAP_STAFF_PIN=2468
TABLETAP_RESTAURANT_ID=demo-restaurant

# Optional POS bridge endpoint. This can point to a POS middleware service,
# automation tool, or custom endpoint that translates TableTap requests into
# your restaurant's POS system.
POS_WEBHOOK_URL=
POS_WEBHOOK_SECRET=

# Optional Toast-specific bridge endpoint. Direct Toast API access requires
# Toast credentials, scopes, and restaurant approval, so TableTap sends to a
# bridge first.
TOAST_BRIDGE_WEBHOOK_URL=
TOAST_BRIDGE_SECRET=
TOAST_RESTAURANT_EXTERNAL_ID=
TOAST_LOCATION_NAME=
